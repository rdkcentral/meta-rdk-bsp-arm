[Unit]
Description=USP Agent
After=syslog.target network.target


[Service]
ExecStartPre=/bin/sh -c 'while [ "`sysevent get current_wan_state`" != "up" ] ; do   sleep 1; done'
ExecStart=/bin/sh '/usr/bin/obuspa --plugin /usr/libexec/usp-pa-vendor-rdk.so -v1 --resetfile /etc/usp-pa/usp_factory_reset.conf --truststore /etc/usp-pa/usp_truststore.pem --interface "$(sysevent get current_wan_ifname)" --log syslog --dbfile /nvram/usp-pa.db'


RestartSec=30
Restart=always

[Install]
WantedBy=multi-user.target

