[Unit]
Description=USP Agent
After=RdkWanManager.service wan-initialized.target

[Service]
ExecStart=/usr/bin/obuspa --plugin /usr/libexec/usp-pa-vendor-rdk.so -v1 --resetfile /etc/usp-pa/usp_factory_reset.conf --truststore /etc/usp-pa/usp_truststore.pem --interface erouter0 --log syslog --dbfile /nvram/usp-pa.db
RestartSec=30
Restart=always

[Install]
WantedBy=wan-initialized.target
