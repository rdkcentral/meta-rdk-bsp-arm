Subject: [PATCH] Remove _PLATFORM_TURRIS_ flags

Removed the Turris ETHWAN_DEF_INTF_NAME ("eth2").

---
 source/TR-181/include/ethernet_apis.h | 2 --
 1 file changed, 2 deletions(-)

diff --git a/source/TR-181/include/ethernet_apis.h b/source/TR-181/include/ethernet_apis.h
index cfd56b8..7f2f6fa 100644
--- a/source/TR-181/include/ethernet_apis.h
+++ b/source/TR-181/include/ethernet_apis.h
@@ -155,8 +155,6 @@ typedef enum
 #define ETHWAN_DEF_INTF_NAME "eth5"
 #elif defined (INTEL_PUMA7)
 #define ETHWAN_DEF_INTF_NAME "nsgmii0"
-#elif defined (_PLATFORM_TURRIS_)
-#define ETHWAN_DEF_INTF_NAME "eth2"
 #else
 #define ETHWAN_DEF_INTF_NAME "eth0"
 #endif
